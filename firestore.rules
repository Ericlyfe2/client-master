rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // WebRTC video-call signaling. Holds short-lived SDP offer/answer + ICE
    // candidates exchanged between a student (caller) and pharmacist (callee).
    // Access is open because anonymous callers need to create/read rooms,
    // and signaling must work without pre-authentication. Rooms auto-expire
    // via a Cloud Function TTL (or client-side cleanup).
    match /videoRooms/{roomId} {
      allow read, write: if true;
      match /{subcollection}/{candidateId} {
        allow read, write: if true;
      }
    }

    // Default: deny all other access. No data should be stored in Firestore
    // that requires broader rules — use PostgreSQL (via Next.js API routes)
    // for all app data.
    // Live delivery GPS. Courier writes their device position; the student
    // (often anonymous) reads it. Open for now — tighten with Auth + a Cloud
    // Function TTL to purge finished deliveries before production.
    match /deliveryLocations/{deliveryId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
